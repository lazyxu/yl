# 全局示例环境变量（合并 server/.env.example）
# 复制为 .env 并填写真实值用于运行，切勿提交真实凭据到仓库。

# 服务地址与端口
SERVER_URL=
PORT=4567

# 会话与 JWT 密钥（请使用强随机值）
SERVER_SESSION_SECRET=
JWT_SECRET=

# 数据库（MySQL）
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 邮件服务（可选）
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# 说明：在生产部署中建议通过环境变量注入或密钥管理系统
# 是否启用 OCR（默认关闭）
VITE_OCR_ENABLED=false
